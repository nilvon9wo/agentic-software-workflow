<Project>

  <!--
    Central package management: every version lives here, once, so an agent
    adding a reference to one project cannot silently drift it from another.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <!-- Errors as values (Fin/Try). v5 is beta; pinned exactly, upgraded deliberately. -->
    <!--
      [PublicAPI] / [UsedImplicitly]: marks code used from outside the repository
      or by machinery (serialisers, reflection), so it is not mistaken for dead
      code. Compile-time only: the attributes vanish from the built assembly.
    -->
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <!-- Async correctness: VSTHRD110 makes an unobserved async call an error (see .editorconfig). -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <!-- Hyperlinq performance rules (e.g. HLQ012) run in every build. -->
    <PackageVersion Include="NetFabric.Hyperlinq.Analyzer" Version="2.3.0" />
    <PackageVersion Include="LanguageExt.Core" Version="5.0.0-beta-77" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Xfty.Xunit" Version="1.0.0-beta.12" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in child process for SystemProcessRunner's tests: it echoes its
    input, fails on request, or hangs until killed. It is not production code
    and never runs inside the test process, so it is excluded from coverage.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgenticSoftwareWorkflow.TestProcess</RootNamespace>
  </PropertyGroup>

</Project>
